# Registro con verificación de identidad (Textract + Rekognition Face Liveness).
# AWS_REGION=us-east-1
# AWS_REKOGNITION_COLLECTION=brn-clients
# AWS_LIVENESS_ROLE_ARN=arn:aws:iam::123456789012:role/brn-prod-liveness
# Las credenciales no se guardan aquí. En local exporta AWS_PROFILE=josue-admin antes de iniciar.
# En ECS, el SDK obtiene credenciales temporales del task role.
# Parecido mínimo entre el rostro en vivo y la foto del documento (0-100).
# BIOMETRICS_DOCUMENT_SIMILARITY=95
